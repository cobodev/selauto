---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import ContactInfoCard from "../components/ContactInfoCard.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { contact } from "../data/site";
import { contactChannels, emergencySteps } from "../data/contact";

const pageTitle = "Grúas Selauto | Contacto grúa 24h en Cantabria";
const pageDescription =
  "Contacta con Grúas Selauto para asistencia en carretera, retirada o traslado de vehículos. Atención 24h en Cantabria.";

const contactStructuredData = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  name: "Grúas Selauto",
  description: pageDescription,
  telephone: contact.phone.label,
  address: {
    "@type": "PostalAddress",
    streetAddress: contact.address,
    addressRegion: "Cantabria",
    addressCountry: "ES"
  },
  areaServed: contact.area,
  openingHours: "Mo-Su 00:00-23:59"
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={contactStructuredData}
>
  <main class="bg-background text-foreground">
    <SiteHeader />

    <section class="section-shell border-y border-border bg-muted/30">
      <div class="site-container grid gap-12 mt-20 mb-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] text-accent-yellow">Contacto</p>
          <h2 class="font-display text-4xl font-black uppercase leading-none text-foreground md:text-6xl">
            Estamos disponibles 24h.
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
            Contacta con nosostros y coordinamos la asistencia adecuada.
          </p>
        </div>

        <ContactForm />
      </div>
    </section>

    <section class="section-shell bg-accent-yellow text-accent-foreground">
      <div class="site-container grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div>
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] opacity-70">Base y cobertura</p>
          <h2 class="font-display text-4xl font-black uppercase leading-none md:text-6xl">
            Cerca para llegar con criterio.
          </h2>
        </div>
        <div class="rounded-md bg-background p-6 text-foreground md:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-muted-foreground">Base</p>
          <p class="mt-3 font-display text-2xl font-black uppercase leading-tight">{contact.address}</p>
          <p class="mt-4 leading-relaxed text-muted-foreground">{contact.area}</p>
        </div>
      </div>
    </section>
    <SiteFooter />
  </main>
</BaseLayout>
