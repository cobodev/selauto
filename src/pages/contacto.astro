---
import { MapPin, Phone } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import LocationMap from "../components/LocationMap.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { contact, coverageZones } from "../data/site";

const pageTitle = "Grúas Selauto | Contacto grúa 24h en Cantabria";
const pageDescription =
  "Contacta con Grúas Selauto para asistencia en carretera, retirada o traslado de vehículos. Atención 24h en Cantabria.";

const contactStructuredData = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  name: "Grúas Selauto",
  description: pageDescription,
  telephone: contact.phone.label,
  address: {
    "@type": "PostalAddress",
    streetAddress: contact.address,
    addressLocality: "La Penilla De Cayón",
    postalCode: "39650",
    addressRegion: "Cantabria",
    addressCountry: "ES"
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: contact.location.lat,
    longitude: contact.location.lng
  },
  areaServed: contact.area,
  openingHours: "Mo-Su 00:00-23:59"
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={contactStructuredData}
>
  <main class="bg-background text-foreground">
    <SiteHeader />

    <section class="section-shell border-y border-border bg-muted/30">
      <div class="site-container grid gap-12 mt-20 mb-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
        <div>
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] text-accent-yellow">Contacto</p>
          <h1 class="font-display text-4xl font-black uppercase leading-none text-foreground md:text-6xl">
            Estamos disponibles 24h.
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
            Contacta con nosotros o localiza nuestra base en La Penilla de Cayón. El mapa muestra un pin de ubicación y una zona de cobertura orientativa.
          </p>

          <div class="mt-8 space-y-5">
            <a
              href={contact.phone.href}
              class="flex items-center gap-4 rounded-md border border-border bg-card px-6 py-5 transition hover:border-accent-yellow"
            >
              <Phone class="size-7 text-accent-yellow" aria-hidden="true" />
              <div>
                <div class="text-xs uppercase tracking-widest text-muted-foreground">Teléfono 24h</div>
                <div class="font-display text-2xl font-bold">{contact.phone.label}</div>
              </div>
            </a>

            <div class="flex items-start gap-4 rounded-md border border-border bg-card px-6 py-5">
              <MapPin class="mt-1 size-6 text-accent-yellow" aria-hidden="true" />
              <div>
                <div class="text-xs uppercase tracking-widest text-muted-foreground">Base</div>
                <div class="font-semibold">{contact.address}</div>
              </div>
            </div>
          </div>
        </div>

        <LocationMap variant="large" />
      </div>
    </section>

    <section class="section-shell bg-accent-yellow text-accent-foreground">
      <div class="site-container grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div>
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] opacity-70">Base y cobertura</p>
          <h2 class="font-display text-4xl font-black uppercase leading-none md:text-6xl">
            Cerca para llegar con criterio.
          </h2>
        </div>
        <div class="rounded-md bg-background p-6 text-foreground md:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-muted-foreground">Zona de actuación</p>
          <p class="mt-3 font-display text-2xl font-black uppercase leading-tight">{contact.area}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {
              coverageZones.places.slice(0, 6).map((place) => (
                <span class="rounded-md border border-border px-3 py-2 text-sm font-semibold text-foreground">
                  {place}
                </span>
              ))
            }
          </div>
          <p class="mt-5 text-sm leading-relaxed text-muted-foreground">
            Cobertura de ejemplo mostrada en el mapa. La disponibilidad real se confirma al recibir el aviso.
          </p>
        </div>
      </div>
    </section>
    <SiteFooter />
  </main>
</BaseLayout>
