---
import { BadgeCheck, MapPinned, ShieldCheck, Truck } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PageHero from "../components/PageHero.astro";
import ContactSection from "../components/ContactSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { aboutPillars, aboutTimeline, aboutValues } from "../data/about";
import { contact, stats } from "../data/site";

const pageTitle = "Grúas Selauto | Quiénes somos";
const pageDescription =
  "Grúas Selauto es una empresa especializada en auxilio y asistencia en carretera desde 1980, con servicio 24h, flota propia y personal cualificado.";

const icons = {
  badge: BadgeCheck,
  map: MapPinned,
  shield: ShieldCheck,
  truck: Truck
};

const aboutStructuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Grúas Selauto",
  description: pageDescription,
  telephone: contact.phone.label,
  address: {
    "@type": "PostalAddress",
    streetAddress: contact.address,
    addressRegion: "Cantabria",
    addressCountry: "ES"
  },
  areaServed: contact.area
};
---

<BaseLayout title={pageTitle} description={pageDescription} structuredData={aboutStructuredData}>
  <main class="bg-background text-foreground">
    <SiteHeader />
    <PageHero
      eyebrow="Nosotros"
      title="Auxilio en carretera desde 1980."
      description="Más de 40 años ofreciendo un servicio rápido, seguro y profesional, disponible las 24 horas del día, los 365 días del año."
    />

    <section class="section-shell border-y border-border bg-muted/30">
      <div class="site-container">
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
          {
            aboutPillars.map((pillar, index) => {
              const Icon = icons[pillar.icon as keyof typeof icons] ?? BadgeCheck;

              return (
                <article class="service-card motion-reveal rounded-md border border-border bg-card p-6 transition hover:border-accent-yellow md:p-8" data-motion="reveal" style={`--motion-delay: ${index * 80}ms`}>
                  <div class="service-card-icon mb-8 inline-flex size-14 items-center justify-center rounded-md bg-accent-yellow text-accent-foreground">
                    <Icon class="size-7" aria-hidden="true" />
                  </div>
                  <h2 class="font-display text-2xl font-black uppercase leading-tight text-foreground">{pillar.title}</h2>
                  <p class="mt-4 leading-relaxed text-muted-foreground">{pillar.description}</p>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="section-shell">
      <div class="site-container grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div class="motion-reveal" data-motion="reveal">
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] text-accent-yellow">Forma de trabajar</p>
          <h2 class="font-display text-4xl font-black uppercase leading-none text-foreground md:text-6xl">
            Experiencia, coordinación y trato directo.
          </h2>
          <div class="mt-8 flex flex-wrap gap-2">
            {aboutValues.map((value) => (
              <span class="rounded-md border border-border bg-card px-4 py-3 text-xs font-black uppercase tracking-[0.18em] text-foreground">
                {value}
              </span>
            ))}
          </div>
        </div>

        <div class="grid gap-4">
          {
            aboutTimeline.map((item, index) => (
              <article class="motion-reveal grid gap-4 rounded-md border border-border bg-card p-6 sm:grid-cols-[4rem_1fr]" data-motion="reveal" style={`--motion-delay: ${index * 90}ms`}>
                <div class="font-display text-3xl font-black text-accent-yellow">{String(index + 1).padStart(2, "0")}</div>
                <div>
                  <h3 class="font-display text-2xl font-black uppercase text-foreground">{item.label}</h3>
                  <p class="mt-2 leading-relaxed text-muted-foreground">{item.text}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-shell bg-accent-yellow text-accent-foreground">
      <div class="site-container grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div class="motion-reveal" data-motion="reveal">
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] opacity-70">Respuesta y confianza</p>
          <h2 class="font-display text-4xl font-black uppercase leading-none md:text-6xl">
            Soluciones inmediatas cuando más se necesitan.
          </h2>
        </div>
        <div class="motion-reveal rounded-md bg-background p-6 text-foreground md:p-8" data-motion="reveal" style="--motion-delay: 120ms">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-muted-foreground">Flota propia</p>
          <p class="mt-3 font-display text-2xl font-black uppercase leading-tight">
            Vehículos preparados para asistencia, transporte y rescate.
          </p>
          <p class="mt-4 leading-relaxed text-muted-foreground">
            Esta combinación nos permite adaptar cada intervención a las necesidades del cliente, tanto en incidencias urgentes como en traslados programados.
          </p>
        </div>
      </div>
    </section>
    
    <SiteFooter />
  </main>
</BaseLayout>
