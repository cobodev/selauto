---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import FleetCollage from "../components/FleetCollage.astro";
import ContactSection from "../components/ContactSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PhoneButton from "../components/ui/PhoneButton.astro";
import { fleetVehicles } from "../data/fleet";

const pageTitle = "Grúas Selauto | Flota de grúas para asistencia y traslado";
const pageDescription =
  "Conoce la flota de Grúas Selauto: plataformas, portavehículos y unidades de apoyo para asistencia en carretera y traslado de vehículos.";

const fleetStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Flota de Grúas Selauto",
  description: pageDescription,
  itemListElement: fleetVehicles.map((vehicle, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Vehicle",
      name: vehicle.title,
      description: vehicle.description,
      image: vehicle.image
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={fleetStructuredData}
>
  <main class="bg-background text-foreground">
    <SiteHeader />

    <section class="section-shell">
      <div class="site-container">
        <div class="mb-12 grid gap-6 lg:grid-cols-[0.75fr_1.25fr] lg:items-end">
          <div>
            <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] text-accent-yellow">Flota</p>
            <h2 class="font-display text-4xl font-black uppercase leading-none text-foreground md:text-6xl">
              Una grúa para cada aviso.
            </h2>
          </div>
          <p class="max-w-2xl text-lg leading-relaxed text-muted-foreground">
            Cada vehículo cumple una función dentro del servicio: plataformas para turismos, portavehículos,
            unidades de apoyo y equipos pensados para intervenir con rapidez.
          </p>
        </div>

        <FleetCollage />
      </div>
    </section>

    <section class="section-shell border-y border-border bg-muted/30">
      <div class="site-container grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] text-accent-yellow">Disponibilidad</p>
          <h2 class="font-display text-4xl font-black uppercase leading-none text-foreground md:text-6xl">
            El recurso adecuado para la incidencia.
          </h2>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground">
            Al recibir el aviso, valoramos ubicación, tipo de vehículo y destino para coordinar la grúa más apropiada.
          </p>
        </div>
        <div class="rounded-md border border-border bg-card p-6 md:p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-muted-foreground">Asistencia 24h</p>
          <p class="mt-4 text-2xl font-black uppercase leading-tight text-foreground">
            Avería, retirada o traslado: dinos dónde estás y activamos la asistencia.
          </p>
          <div class="mt-8">
            <PhoneButton />
          </div>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</BaseLayout>
