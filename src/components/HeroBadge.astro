---
const { label = "Disponibles 24 / 7 · 365" } = Astro.props;
---

<div class="motion-shine inline-flex items-center gap-2 px-3 py-1 border border-accent-yellow/40 bg-accent-yellow/10 text-accent-yellow text-xs font-semibold tracking-widest uppercase rounded-sm mb-6">
  <span class="h-1.5 w-1.5 rounded-full bg-success animate-pulse"></span>
  {label}
</div>
