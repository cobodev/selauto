---
import { contact, phone } from "../data/site";

const inputClass =
  "w-full rounded-md border border-foreground/10 bg-background px-4 py-3 text-foreground placeholder:text-muted-foreground transition focus:border-foreground focus:outline-none";
---

<form class="space-y-4 rounded-md bg-background p-6 text-foreground shadow-xl sm:p-8">
  <div>
    <p class="mb-1 font-display text-2xl font-black uppercase">Escríbenos</p>
    <p class="text-sm text-muted-foreground">
      Cuéntanos qué necesitas y te llamamos enseguida.
    </p>
  </div>

  <div class="space-y-3">
    <div>
      <label for="cf-name" class="sr-only">Nombre</label>
      <input id="cf-name" type="text" placeholder="Nombre" maxlength="120" class={inputClass} />
    </div>
    <div>
      <label for="cf-phone" class="sr-only">Teléfono</label>
      <input id="cf-phone" type="tel" placeholder="Teléfono" maxlength="40" class={inputClass} />
    </div>
    <div>
      <label for="cf-message" class="sr-only">Mensaje</label>
      <textarea
        id="cf-message"
        placeholder="¿En qué podemos ayudarte? Indica ubicación si es posible."
        rows="5"
        maxlength="2000"
        class={`${inputClass} resize-none`}
      ></textarea>
    </div>
  </div>

  <button
    type="button"
    class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-accent-yellow px-6 py-4 font-bold text-accent-foreground transition hover:brightness-95"
  >
    Enviar mensaje
  </button>

  <p class="text-center text-xs text-muted-foreground">
    ¿Es una emergencia? Llámanos al
    <a href={phone.href} class="font-bold text-foreground underline">{phone.label}</a>
    o al
    <a href={contact.phones[1].href} class="font-bold text-foreground underline">{contact.phones[1].label}</a>.
  </p>
</form>
