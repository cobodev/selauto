---
const { eyebrow, title, description, centered = false } = Astro.props;
---

<div class:list={["section-header", centered ? "mx-auto max-w-3xl text-center" : "grid gap-8 lg:grid-cols-2 lg:items-end"]}>
  <div>
    <p class="mb-6 font-display text-sm font-semibold uppercase tracking-[0.35em] text-accent-yellow">{eyebrow}</p>
    <h2 class="font-display text-5xl font-black uppercase leading-none text-foreground md:text-7xl">{title}</h2>
  </div>
  {description && <p class="text-lg leading-relaxed text-muted-foreground">{description}</p>}
</div>
