---
import StatsGrid from "./StatsGrid.astro";
---

<section id="nosotros" class="section-shell section-divider border-y bg-muted/30">
  <div class="site-container grid gap-16 lg:grid-cols-2 lg:items-center">
    <div class="motion-reveal" data-motion="reveal">
      <p class="mb-6 font-display text-sm font-semibold uppercase tracking-[0.35em] text-accent-yellow">Quiénes somos</p>
      <h2 class="font-display text-5xl font-black uppercase leading-none text-foreground md:text-7xl">
        Más de <span class="text-accent-yellow">40 años</span> en carretera.
      </h2>
      <p class="mt-10 text-lg leading-relaxed text-muted-foreground">
        En <strong class="text-foreground">Grúas SELAUTO</strong> estamos especializados en auxilio y asistencia en carretera desde 1980. Ofrecemos un servicio rápido, seguro y profesional durante las 24 horas del día, los 365 días del año.
      </p>
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        Nuestra flota y nuestro equipo cualificado nos permiten atender asistencias, transportes de vehículos y rescates con soluciones inmediatas y de confianza.
      </p>
    </div>
    <div class="motion-reveal" data-motion="reveal" style="--motion-delay: 120ms">
      <StatsGrid />
    </div>
  </div>
</section>
