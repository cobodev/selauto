---
import StatsGrid from "./StatsGrid.astro";
---

<section id="nosotros" class="section-shell border-y border-border bg-muted/30">
  <div class="site-container grid gap-16 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="mb-6 font-display text-sm font-semibold uppercase tracking-[0.35em] text-accent-yellow">Quiénes somos</p>
      <h2 class="font-display text-5xl font-black uppercase leading-none text-foreground md:text-7xl">
        Una empresa <span class="text-accent-yellow">local</span> de confianza.
      </h2>
      <p class="mt-10 text-lg leading-relaxed text-muted-foreground">
        En <strong class="text-foreground">Grúas SELAUTO</strong> llevamos años ayudando a conductores en la carretera. Conocemos la zona, trabajamos con las principales compañías de asistencia y respondemos rápido.
      </p>
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        Profesionalidad, transparencia y un trato directo. Sin sorpresas.
      </p>
    </div>
    <StatsGrid />
  </div>
</section>
