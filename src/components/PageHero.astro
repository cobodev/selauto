---
const { eyebrow = "Página", title, description } = Astro.props;
---

<section class="section-shell border-b border-border bg-background pt-32">
  <div class="site-container">
    <div class="max-w-3xl">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] text-accent-yellow">{eyebrow}</p>
      <h1 class="font-display text-5xl font-black uppercase leading-none text-balance md:text-7xl">
        {title}
      </h1>
      {
        description && (
          <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
            {description}
          </p>
        )
      }
    </div>
  </div>
</section>
