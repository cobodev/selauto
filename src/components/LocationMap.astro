---
import { MapPin, Navigation } from "lucide-astro";
import { contact } from "../data/site";

const { variant = "compact" } = Astro.props;
const isLarge = variant === "large";
const directionsHref = `https://www.openstreetmap.org/directions?to=${contact.location.lat}%2C${contact.location.lng}`;
---

<div class:list={["overflow-hidden rounded-md border border-border bg-card text-foreground", isLarge ? "h-full" : ""]}>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <div
    class:list={[
      "location-map relative z-0 w-full bg-muted",
      isLarge ? "h-[28rem] md:h-[36rem]" : "h-[24rem] md:h-[30rem]"
    ]}
    data-location-map
    data-lat={contact.location.lat}
    data-lng={contact.location.lng}
    data-radius={contact.coverageRadiusKm * 1000}
    data-title="Base Grúas Selauto"
    data-address={contact.address}
  ></div>

  <div class="grid gap-5 border-t border-border p-5 md:grid-cols-[1fr_auto] md:items-center md:p-6">
    <div class="flex gap-4">
      <div class="inline-flex size-11 shrink-0 items-center justify-center rounded-md bg-accent-yellow text-accent-foreground">
        <MapPin class="size-5" aria-hidden="true" />
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-muted-foreground">Base Selauto</p>
        <p class="mt-2 font-display text-xl font-black uppercase leading-tight text-foreground">{contact.address}</p>
      </div>
    </div>

    <a
      href={directionsHref}
      target="_blank"
      rel="noreferrer"
      class="inline-flex items-center justify-center gap-2 rounded-md bg-accent-yellow px-5 py-3 text-sm font-bold text-accent-foreground transition hover:brightness-95"
    >
      <Navigation class="size-4" aria-hidden="true" />
      Cómo llegar
    </a>
  </div>
</div>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script is:inline>
  (() => {
    const initMaps = () => {
      if (!window.L) return;

      document.querySelectorAll("[data-location-map]:not([data-map-ready])").forEach((mapElement) => {
        const lat = Number(mapElement.dataset.lat);
        const lng = Number(mapElement.dataset.lng);
        const radius = Number(mapElement.dataset.radius);
        const title = mapElement.dataset.title || "Base";
        const address = mapElement.dataset.address || "";

        if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;

        mapElement.setAttribute("data-map-ready", "true");

        const map = window.L.map(mapElement, {
          scrollWheelZoom: false,
          zoomControl: true
        }).setView([lat, lng], 11);

        window.L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          attribution: "&copy; OpenStreetMap"
        }).addTo(map);

        window.L.circle([lat, lng], {
          radius,
          color: "#facc15",
          fillColor: "#facc15",
          fillOpacity: 0.16,
          opacity: 0.8,
          weight: 2
        }).addTo(map);

        window.L.marker([lat, lng])
          .addTo(map)
          .bindPopup(`<strong>${title}</strong><br>${address}`)
          .openPopup();
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMaps);
    } else {
      initMaps();
    }

    window.addEventListener("load", initMaps);
  })();
</script>

<style>
  .location-map .leaflet-tile {
    filter: saturate(0.72) brightness(0.72) contrast(1.08);
  }

  .location-map .leaflet-container,
  .location-map.leaflet-container {
    background: var(--card);
    font-family: system-ui, sans-serif;
  }

  .location-map .leaflet-control-attribution {
    background: color-mix(in oklab, var(--background) 82%, transparent);
    color: var(--muted-foreground);
  }

  .location-map .leaflet-popup-content-wrapper,
  .location-map .leaflet-popup-tip {
    background: var(--background);
    color: var(--foreground);
    border: 1px solid var(--border);
  }
</style>
