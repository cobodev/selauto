---
import { CalendarDays, Clock, ShieldCheck, Truck } from "lucide-astro";
import { features } from "../data/site";

const icons = [Clock, CalendarDays, ShieldCheck, Truck];
---

<section class="section-divider border-y bg-muted/30">
  <div class="site-container grid grid-cols-2 gap-6 py-6 md:grid-cols-4">
    {
      features.map((feature, index) => {
        const Icon = icons[index];
        return (
          <div class="motion-reveal flex items-center gap-3" data-motion="reveal" style={`--motion-delay: ${index * 70}ms`}>
            <Icon class="size-5 text-accent-yellow" aria-hidden="true" />
            <span class="font-display text-sm font-semibold uppercase tracking-wider text-foreground">{feature.label}</span>
          </div>
        );
      })
    }
  </div>
</section>
