---
import HeroBadge from "./HeroBadge.astro";
import PhoneButton from "./ui/PhoneButton.astro";
import OutlineButton from "./ui/OutlineButton.astro";
---

<section id="top" class="relative flex min-h-screen items-end overflow-hidden" data-motion-hero>
  <img
    src="/assets/hero-grua-noche.png"
    alt="Grúa Selauto de asistencia en carretera"
    class="theme-image theme-image-night hero-parallax-media absolute inset-0 h-full w-full object-cover"
    data-parallax-speed="54"
  />
  <img
    src="/assets/hero-grua-dia.png"
    alt=""
    class="theme-image theme-image-day hero-parallax-media absolute inset-0 h-full w-full object-cover"
    data-parallax-speed="54"
    aria-hidden="true"
  />
  <div class="hero-overlay-v absolute inset-0"></div>
  <div class="hero-overlay-h absolute inset-0"></div>
  <div class="site-container relative mx-auto max-w-7xl px-6 pb-24 pt-40 w-full">
    <div class="hero-copy max-w-3xl">
      <div class="motion-reveal" data-motion="reveal">
        <HeroBadge />
      </div>
      <h1 class="motion-reveal mt-6 font-display text-5xl font-black uppercase leading-[0.9] text-foreground sm:text-7xl lg:text-8xl" data-motion="reveal" style="--motion-delay: 90ms">
        Asistencia<br />en carretera.<br />
        <span class="italic">
          <span class="brand-reveal" style="--brand-delay: 220ms"><span><span class="text-accent-yellow">SEL</span>AUTO</span></span><span class="brand-reveal-dot inline-block text-accent-yellow">.</span>
        </span>
      </h1>
      <p class="motion-reveal mt-6 max-w-xl text-lg text-muted-foreground" data-motion="reveal" style="--motion-delay: 180ms">
        Grúa local, rápida y profesional. Te sacamos del apuro a cualquier hora, en cualquier punto.
      </p>
      <div class="motion-reveal mt-8 flex flex-wrap gap-3" data-motion="reveal" style="--motion-delay: 270ms">
        <PhoneButton />
        <OutlineButton href="#servicios" label="Nuestros servicios" />
      </div>
    </div>
  </div>
</section>
