---
import HeroBadge from "./HeroBadge.astro";
import PhoneButton from "./ui/PhoneButton.astro";
import OutlineButton from "./ui/OutlineButton.astro";
---

<section id="top" class="relative flex min-h-screen items-end overflow-hidden">
  <img
    src="/assets/hero-grua-noche.png"
    alt="Grúa Selauto de asistencia en carretera"
    class="theme-image theme-image-night absolute inset-0 h-full w-full object-cover"
  />
  <img
    src="/assets/hero-grua-dia.png"
    alt=""
    class="theme-image theme-image-day absolute inset-0 h-full w-full object-cover"
    aria-hidden="true"
  />
  <div class="hero-overlay-vertical absolute inset-0"></div>
  <div class="hero-overlay-horizontal absolute inset-0"></div>
  <div class="site-container relative mx-auto max-w-7xl px-6 pb-24 pt-40 w-full">
    <div class="max-w-3xl">
      <HeroBadge />
      <h1 class="mt-6 font-display text-5xl font-black uppercase leading-[0.9] text-foreground sm:text-7xl lg:text-8xl">
        Asistencia<br />en carretera.<br />
        <span class="italic"><span class="text-accent-yellow">SEL</span>AUTO<span class="text-accent-yellow">.</span></span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted-foreground">
        Grúa local, rápida y profesional. Te sacamos del apuro a cualquier hora, en cualquier punto.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <PhoneButton />
        <OutlineButton href="#servicios" label="Nuestros servicios" />
      </div>
    </div>
  </div>
</section>
