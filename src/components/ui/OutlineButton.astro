---
import { ArrowRight } from "lucide-astro";

const { href = "#", label } = Astro.props;
---

<a href={href} class="inline-flex items-center gap-2 rounded-md border border-border px-6 py-4 font-semibold text-foreground transition hover:bg-muted">
  {label}
  <ArrowRight class="size-4" aria-hidden="true" />
</a>
