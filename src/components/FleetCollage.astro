---
import { fleetVehicles } from "../data/fleet";

const layoutClasses = {
  featured: "md:col-span-4 md:row-span-2",
  tall: "md:col-span-2 md:row-span-2",
  wide: "md:col-span-3 md:row-span-1"
};
---

<div class="grid auto-rows-[22rem] gap-4 md:grid-cols-6 md:auto-rows-[18rem] lg:auto-rows-[20rem]">
  {
    fleetVehicles.map((vehicle, index) => (
      <article
        class:list={[
          "motion-reveal fleet-card",
          "group relative isolate overflow-hidden rounded-md border border-border bg-card",
          "transition duration-300 hover:-translate-y-1 hover:border-accent-yellow hover:shadow-[0_24px_60px_color-mix(in_oklab,var(--accent-yellow)_16%,transparent)]",
          layoutClasses[vehicle.layout] ?? "md:col-span-3"
        ]}
        data-motion="reveal"
        style={`--motion-delay: ${index * 80}ms`}
      >
        <img
          src={vehicle.image}
          alt={vehicle.alt}
          width="1448"
          height="1086"
          loading={index < 2 ? "eager" : "lazy"}
          decoding="async"
          class="size-full object-cover transition duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-background via-background/28 to-transparent opacity-90 transition duration-300 group-hover:opacity-95"></div>
        <div class="absolute inset-x-0 bottom-0 p-5 md:p-6">
          <p class="mb-3 inline-flex rounded-md bg-accent-yellow px-3 py-1 text-xs font-black uppercase tracking-[0.18em] text-accent-foreground">
            {String(index + 1).padStart(2, "0")}
          </p>
          <h2 class="font-display text-2xl font-black uppercase leading-none text-foreground md:text-3xl">
            {vehicle.title}
          </h2>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground md:text-base">
            {vehicle.description}
          </p>
        </div>
      </article>
    ))
  }
</div>
