---
import { MapPin, Phone } from "lucide-astro";
import LocationMap from "./LocationMap.astro";
import { contact } from "../data/site";
---

<section id="contacto" class="section-shell bg-accent-yellow text-accent-foreground">
  <div class="site-container grid gap-12 lg:grid-cols-2 lg:items-start">
    <div class="motion-reveal" data-motion="reveal">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] opacity-70">¿Una avería?</p>
      <h2 class="font-display text-5xl font-black uppercase leading-none md:text-7xl">
        Llámanos.<br />Estamos en camino.
      </h2>

      <div class="mt-10 space-y-6">
        <div class="flex items-start gap-4 rounded-md bg-background px-6 py-6 text-foreground">
          <Phone class="size-8 text-accent-yellow" aria-hidden="true" />
          <div class="min-w-0">
            <div class="text-xs uppercase tracking-widest text-muted-foreground">Teléfonos 24h</div>
            <div class="mt-3 grid gap-3">
              {
                contact.phones.map((item) => (
                  <a
                    href={item.href}
                    class="group block transition hover:text-accent-yellow"
                  >
                    <span class="block text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground group-hover:text-accent-yellow">
                      {item.shortLabel}
                    </span>
                    <span class="font-display text-2xl font-bold md:text-3xl">{item.label}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <div class="flex items-start gap-4 px-6">
          <MapPin class="mt-1 size-6" aria-hidden="true" />
          <div>
            <div class="text-xs uppercase tracking-widest opacity-70">Base</div>
            <div class="font-semibold">{contact.address}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="motion-reveal" data-motion="reveal" style="--motion-delay: 120ms">
      <LocationMap />
    </div>
  </div>
</section>
