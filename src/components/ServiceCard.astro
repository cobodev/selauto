---
import { BatteryCharging, Clock, Disc3, Route, ShieldAlert, Truck, Wrench } from "lucide-astro";

const { title, description, icon = "truck", motionDelay = 0 } = Astro.props;

const icons = {
  "battery-charging": BatteryCharging,
  clock: Clock,
  disc: Disc3,
  route: Route,
  "shield-alert": ShieldAlert,
  truck: Truck,
  wrench: Wrench
};

const Icon = icons[icon] ?? Truck;
---

<article
  class="service-card motion-reveal group relative border border-border bg-card p-8 rounded-md transition-colors hover:border-accent-yellow"
  data-motion="reveal"
  style={`--motion-delay: ${motionDelay}ms`}
>
  <div class="service-card-icon mb-12 inline-flex size-16 items-center justify-center rounded-md bg-accent-yellow text-accent-foreground">
    <Icon class="size-7" aria-hidden="true" />
  </div>
  <h3 class="font-display text-3xl font-black uppercase text-foreground">{title}</h3>
  <p class="mt-4 leading-relaxed text-muted-foreground">{description}</p>
</article>
