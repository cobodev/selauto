---
import SectionHeader from "./SectionHeader.astro";
import ServiceCard from "./ServiceCard.astro";
import OutlineButton from "./ui/OutlineButton.astro";
import { services } from "../data/site";
---

<section id="servicios" class="section-shell">
  <div class="site-container">
    <SectionHeader
      eyebrow="Servicios"
      title="Asistencia para cada incidencia."
      description="Los servicios más habituales de Grúas Selauto: respuesta urgente, transporte, rescate y ayuda en carretera con flota propia."
    />
    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {services.map((service, index) => <ServiceCard title={service.title} description={service.description} icon={service.icon} featured={service.featured} motionDelay={index * 80} />)}
    </div>
    <div class="mt-10">
      <OutlineButton href="/servicios" label="Ver todos los servicios" />
    </div>
  </div>
</section>
