---
import SectionHeader from "./SectionHeader.astro";
import ServiceCard from "./ServiceCard.astro";
import { services } from "../data/site";
---

<section id="servicios" class="section-shell">
  <div class="site-container">
    <SectionHeader
      eyebrow="Servicios"
      title="Lo que hacemos, lo hacemos bien."
      description="Más de una década dando servicio en carretera con flota propia y personal cualificado."
    />
    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {services.map((service) => <ServiceCard title={service.title} description={service.description} />)}
    </div>
  </div>
</section>
