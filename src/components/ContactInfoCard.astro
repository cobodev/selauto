---
import { Clock, MapPin, Phone } from "lucide-astro";

const { label, title, description, href, icon = "phone" } = Astro.props;

const icons = {
  clock: Clock,
  "map-pin": MapPin,
  phone: Phone
};

const Icon = icons[icon] ?? Phone;
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    "motion-reveal group flex h-full gap-5 rounded-md border border-border bg-card p-6 transition",
    href ? "hover:-translate-y-1 hover:border-accent-yellow" : ""
  ]}
  data-motion="reveal"
>
  <div class="inline-flex size-12 shrink-0 items-center justify-center rounded-md bg-accent-yellow text-accent-foreground">
    <Icon class="size-6" aria-hidden="true" />
  </div>
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-muted-foreground">{label}</p>
    <h2 class="mt-2 font-display text-2xl font-black uppercase leading-tight text-foreground">{title}</h2>
    <p class="mt-3 leading-relaxed text-muted-foreground">{description}</p>
  </div>
</Tag>
